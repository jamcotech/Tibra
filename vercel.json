{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "cleanUrls": true,
  "trailingSlash": false,
  "redirects": [
    {
      "source": "/assets/purefix-bottle-box-showcase.jpg",
      "destination": "/assets/tibra-naturals-pain-relief-oil-box-packaging.webp",
      "permanent": true
    },
    {
      "source": "/assets/purefix-bottle-box-showcase.webp",
      "destination": "/assets/tibra-naturals-pain-relief-oil-box-packaging.webp",
      "permanent": true
    },
    {
      "source": "/assets/purefix-bottle-transparent.webp",
      "destination": "/assets/tibra-naturals-pain-relief-oil-bottle-30ml.webp",
      "permanent": true
    },
    {
      "source": "/assets/purefix-bottle-004-transparent.webp",
      "destination": "/assets/tibra-naturals-pain-relief-oil-bottle-30ml.webp",
      "permanent": true
    },
    {
      "source": "/assets/purefix-bottle-transparent.png",
      "destination": "/assets/tibra-naturals-pain-relief-oil-bottle-30ml.webp",
      "permanent": true
    },
    {
      "source": "/assets/purefix-logo.png",
      "destination": "/assets/tibra-naturals-brand-logo.png",
      "permanent": true
    }
  ],
  "rewrites": [
    {
      "source": "/admin",
      "destination": "/index.html"
    },
    {
      "source": "/admin/",
      "destination": "/index.html"
    },
    {
      "source": "/admin/(.*)",
      "destination": "/index.html"
    },
    {
      "source": "/((?!api).*)",
      "destination": "/index.html"
    }
  ],
  "headers": [
    {
      "source": "/assets/(.*)",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=31536000, immutable"
        }
      ]
    },
    {
      "source": "/robots.txt",
      "headers": [
        {
          "key": "Content-Type",
          "value": "text/plain; charset=utf-8"
        },
        {
          "key": "Cache-Control",
          "value": "public, max-age=3600, must-revalidate"
        }
      ]
    },
    {
      "source": "/sitemap.xml",
      "headers": [
        {
          "key": "Content-Type",
          "value": "application/xml; charset=utf-8"
        },
        {
          "key": "Cache-Control",
          "value": "public, max-age=3600, must-revalidate"
        }
      ]
    }
  ]
}
